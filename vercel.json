{
  "rewrites": [
    { "source": "/api/document-preview", "destination": "/api/public-products?route=preview" },
    { "source": "/api/document-download", "destination": "/api/public-products?route=download" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
